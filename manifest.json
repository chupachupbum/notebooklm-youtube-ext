{
  "manifest_version": 3,
  "name": "NotebookLM YouTube Summarizer",
  "version": "0.1.0",
  "description": "Summarize YouTube videos using Google NotebookLM without leaving YouTube.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://notebooklm.google.com/*",
        "https://notebook.google.com/*"
      ],
      "js": [
        "content/notebooklm-controller.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "content/youtube-injector.js"
      ],
      "css": [
        "content/youtube-injector.css"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel/sidepanel.html",
        "sidepanel/sidepanel.css",
        "sidepanel/sidepanel.js",
        "sidepanel/onboarding.css",
        "sidepanel/onboarding.js",
        "lib/markdown.js",
        "icons/*"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "NotebookLM YouTube Summarizer"
  }
}
